{
  "name": "node_backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --ignore *.sqlite --ignore *.sqlite-journal src/index.js",
    "test": "echo \"No tests configured\"",
    "test:fotos": "node --experimental-test-module-mocks --test --test-isolation=none tests/atendimento-fotos.test.js",
    "vercel-build": "npx sequelize-cli db:migrate",
    "migrate": "node scripts/migrate-all.js",
    "create-schema": "node scripts/createSchemaClient.js",
    "seed-user": "npx sequelize-cli db:seed --seed 20260520141621-demo-user.cjs",
    "worker": "node src/worker-runner.js",
    "migrar-fotos-b2": "node scripts/migrar-fotos-b2.js",
    "migrar-fotos-b2:dry": "node scripts/migrar-fotos-b2.js --dry-run",
    "test:b2": "node --experimental-test-module-mocks --test --test-isolation=none tests/b2-storage.test.js",
    "test:security": "node --experimental-test-module-mocks --test --test-isolation=none tests/security.test.js",
    "security:encrypt-b2": "node scripts/encrypt-b2-credentials.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@date-fns/tz": "^1.5.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.4",
    "umzug": "^3.8.3",
    "uuid": "^14.0.2",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sqlite3": "^6.0.1"
  }
}

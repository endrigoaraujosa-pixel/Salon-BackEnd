# Gere um valor próprio de 32 bytes (64 caracteres hexadecimais).
# Mantenha em segredo e preserve em backup separado do banco. Não rotacione sem recifrar.
B2_CREDENTIAL_ENCRYPTION_KEY=

# URLs adicionais da Evolution autorizadas pelo administrador da infraestrutura.
# Separe por vírgulas. A chave global só vai para EVOLUTION_API_URL e instância da empresa.
EVOLUTION_ALLOWED_URLS=

# Opcional: IPs/CIDRs dos proxies confiáveis, separados por vírgulas.
# Não use true ou 0.0.0.0/0; somente os proxies efetivamente controlados.
TRUST_PROXY=
